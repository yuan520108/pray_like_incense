class HomePage extends StatefulWidget {
  final Map<String, dynamic> user;
  final YCoinService yCoinService;
  final WitnessService witnessService;
  final PostsRepository postsRepository;

  const HomePage({
    super.key,
    required this.user,
    required this.yCoinService,
    required this.witnessService,
    required this.postsRepository,
  });

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  int _selectedIndex = 0;
  List<PrayerPost> _posts = [];
  bool _isLoading = false;
  int _yCoinBalance = 0;
  String? _errorMessage;

  @override
  void initState() {
    super.initState();
    _loadPosts();
    _loadYCoinBalance();
  }

  Future<void> _loadPosts() async {
    setState(() {
      _isLoading = true;
      _errorMessage = null;
    });
    
    try {
      // ?�裡?�該調用API?��?貼�?
      // _posts = await _postsService.getPosts(limit: 25);
      
      // 模擬?��??��?
      await Future.delayed(const Duration(seconds: 1));
      
      // 模擬一些測試數??
      _posts = [
        PrayerPost(
          postId: '1',
          userId: widget.user['userId']?.toString() ?? 'unknown_user',
          authorName: widget.user['displayName']?.toString() ?? 'Unknown User',
          avatarUrl: widget.user['avatarUrl']?.toString(),
          title: 'First Prayer Post',
          content: 'This is my first prayer post content.',
          category: 'Personal & Family',
          privacy: 'public',
          createdAt: DateTime.now(),
          amenCount: 5,
          commentCount: 2,
          witnessCount: 1,
          amened: false,
          witnessed: false,
        ),
        PrayerPost(
          postId: '2',
          userId: 'other_user',
          authorName: 'Other User',
          avatarUrl: null,
          title: 'Another Prayer',
          content: 'This is another prayer post.',
          category: 'Church & Ministry',
          privacy: 'public',
          createdAt: DateTime.now().subtract(const Duration(hours: 2)),
          amenCount: 3,
          commentCount: 1,
          witnessCount: 0,
          amened: false,
          witnessed: false,
        ),
      ];
      
      setState(() {
        _isLoading = false;
      });
    } catch (error) {
      setState(() {
        _isLoading = false;
        _errorMessage = 'Failed to load posts: $error';
      });
    }
  }

  Future<void> _loadYCoinBalance() async {
    try {
      final userId = widget.user['userId']?.toString() ?? 'unknown_user';
      final balance = await widget.yCoinService.getYCoinBalance(userId);
      setState(() {
        _yCoinBalance = balance;
      });
    } catch (error) {
      print('Failed to load Y coin balance: $error');
    }
  }

